rules_version = '2';
// Reglas ESTRICTAS. No desplegar hasta el checklist de docs/firestore-auth.md.
// Fase 0 (hoy en producción): las reglas abiertas siguen en la consola y este
// archivo NO está desplegado. No hay un interruptor authRequired dentro de las
// reglas: un despliegue a medias no puede dejar la base abierta otra vez.
//
// Diseño (plan Spark, sin Cloud Functions):
// - Entrenador: Firebase Auth con Google. Es entrenador si el custom claim
//   role == 'coach' (mejor a medio plazo; hace falta Admin SDK una vez) O si
//   su uid es el de la allowlist de abajo. Sustituir el marcador por el UID
//   real antes de desplegar. Ese marcador no es una cuenta real: el SDK de
//   cliente no puede elegir su propio uid.
// - Cliente: cuenta email/contraseña sintética creada por el entrenador.
//   Solo lee y escribe clients/{id} si authUid == request.auth.uid.
//   No puede leer clients/coach_data (códigos, negocio, contratos, CRM).
// - Tokens push: viven dentro del documento (clients/{id}.push y
//   coach_data.negocio.coachPush). Firestore no oculta campos sueltos;
//   al cerrar el documento entero, el token solo lo ve su dueño o el entrenador.
// - contacts/{id}: CRM fuera del documento de 1 MiB. Solo el entrenador.
//
// Las condiciones van en la MISMA allow que concede el acceso. En Firestore
// varias allow se combinan con OR, así que una segunda regla no puede negar
// lo que otra ya ha permitido.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isCoach() {
      return signedIn() && (
        request.auth.token.get('role', '') == 'coach'
        || request.auth.uid == 'REEMPLAZAR_UID_DEL_COACH'
      );
    }

    // GUARDIA _rev (la que tiene producción desde el 2026-11-07): solo se acepta la escritura del guardado
    // seguro, con _rev exactamente el anterior + 1. Una pestaña o app antigua que escribe datos viejos se rechaza.
    function revOk() {
      return resource == null
        ? request.resource.data.get('_rev', 0) == 1
        : request.resource.data.get('_rev', -1) == resource.data.get('_rev', 0) + 1;
    }

    // coach_data no lleva authUid. Un where('authUid') no puede alcanzarlo
    // y un cliente no puede hacerse dueño de la meta del entrenador.
    function coachMetaWriteOk(clientId) {
      return clientId != 'coach_data'
        || (!('authUid' in request.resource.data) && !('authUids' in request.resource.data));
    }

    // authUid: la cuenta del código principal. authUids (opcional): todas las cuentas del
    // cliente cuando tenía más de un código válido; así ninguno deja de funcionar al migrar.
    function ownsClient() {
      return signedIn() && (
        resource.data.get('authUid', null) == request.auth.uid
        || request.auth.uid in resource.data.get('authUids', [])
      );
    }

    // El cliente no puede cambiar quién es el dueño de su ficha.
    function ownersUnchanged() {
      return request.resource.data.get('authUid', null) == resource.data.get('authUid', null)
        && request.resource.data.get('authUids', []) == resource.data.get('authUids', []);
    }

    // Campos que SOLO cambia el entrenador. El cliente escribe su registro (blocks), sus formularios
    // (fichas), sus avisos (push), etc., pero no puede cambiar su nombre, su código, sus pagos ni lo que
    // el entrenador configura para él, ni sus valoraciones (backRehab). mods, serviceType, notifs y backRehab los rellena la app con valores por
    // defecto si faltan: el cliente puede CREARLOS si no existen, nunca cambiarlos.
    // (authUid/authUids: ownersUnchanged.)
    function clientFieldsOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['code', 'name', 'pagos'])
        && (!changed.hasAny(['mods']) || !('mods' in resource.data))
        && (!changed.hasAny(['serviceType']) || !('serviceType' in resource.data))
        && (!changed.hasAny(['notifs']) || !('notifs' in resource.data))
        && (!changed.hasAny(['backRehab']) || !('backRehab' in resource.data));
    }


    match /clients/{clientId} {
      allow get, list: if isCoach() || ownsClient();

      allow create: if isCoach() && coachMetaWriteOk(clientId) && revOk();

      allow update: if coachMetaWriteOk(clientId) && revOk() && (
        isCoach()
        || (ownsClient() && ownersUnchanged() && clientFieldsOk())
      );

      allow delete: if isCoach();
    }

    match /contacts/{contactId} {
      allow read, write: if isCoach();
    }

    // Catálogo de vídeos para clientes (shared/client-catalog.js): nombre + vídeo general de la
    // biblioteca propia. Sin datos personales. Lo lee cualquier sesión; solo escribe el entrenador.
    match /catalog/{docId} {
      allow get: if signedIn() && docId == 'exercises';
      allow create, update: if isCoach() && docId == 'exercises'
        && request.resource.data.keys().hasOnly(['items', 'count', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 3000;
      allow delete: if isCoach();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
