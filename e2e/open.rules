rules_version = '2';
// SOLO PARA EL EMULADOR LOCAL de las pruebas e2e. Nunca se despliega:
// e2e/firebase.e2e.json no tiene destino de despliegue y se arranca siempre
// con un proyecto "demo-", que no puede existir en la nube.
// Imita la fase 0 de docs/firestore-auth.md (AUTH_ENABLED = false).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
