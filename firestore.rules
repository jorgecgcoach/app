rules_version = '2';
// Reglas ESTRICTAS. No desplegar hasta el checklist de docs/firestore-auth.md.
// Fase 0 (hoy en producción): las reglas abiertas siguen en la consola y este
// archivo NO está desplegado. No hay un interruptor authRequired dentro de las
// reglas: un despliegue a medias no puede dejar la base abierta otra vez.
//
// Diseño (plan Spark, sin Cloud Functions):
// - Entrenador: Firebase Auth con Google. Es entrenador si el custom claim
//   role == 'coach' (mejor a medio plazo; hace falta Admin SDK una vez) O si
//   su uid es el de la allowlist de abajo. Sustituir el marcador por el UID
//   real antes de desplegar. Ese marcador no es una cuenta real: el SDK de
//   cliente no puede elegir su propio uid.
// - Cliente: cuenta email/contraseña sintética creada por el entrenador.
//   Solo lee y escribe clients/{id} si authUid == request.auth.uid.
//   No puede leer clients/coach_data (códigos, negocio, contratos, CRM).
// - Tokens push: viven dentro del documento (clients/{id}.push y
//   coach_data.negocio.coachPush). Firestore no oculta campos sueltos;
//   al cerrar el documento entero, el token solo lo ve su dueño o el entrenador.
// - contacts/{id}: CRM fuera del documento de 1 MiB. Solo el entrenador.
//
// Las condiciones van en la MISMA allow que concede el acceso. En Firestore
// varias allow se combinan con OR, así que una segunda regla no puede negar
// lo que otra ya ha permitido.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isCoach() {
      return signedIn() && (
        request.auth.token.role == 'coach'
        || request.auth.uid == 'REEMPLAZAR_UID_DEL_COACH'
      );
    }

    // coach_data no lleva authUid. Un where('authUid') no puede alcanzarlo
    // y un cliente no puede hacerse dueño de la meta del entrenador.
    function coachMetaWriteOk(clientId) {
      return clientId != 'coach_data' || !('authUid' in request.resource.data);
    }

    function ownsClient() {
      return signedIn() && resource.data.authUid == request.auth.uid;
    }

    match /clients/{clientId} {
      allow get, list: if isCoach() || ownsClient();

      allow create: if isCoach() && coachMetaWriteOk(clientId);

      allow update: if coachMetaWriteOk(clientId) && (
        isCoach()
        || (ownsClient() && request.resource.data.authUid == resource.data.authUid)
      );

      allow delete: if isCoach();
    }

    match /contacts/{contactId} {
      allow read, write: if isCoach();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
